# PublicGex Dashboard market-data credentials. Both values are required.
# Paste your values after the equals signs; leave no placeholder text.
PUBLIC_API_KEY=
PUBLIC_ACCOUNT_ID=

# Save a copy named .env in the active workspace shown in Settings.
# Desktop launchers / installed app:
#   %LOCALAPPDATA%\com.publicgex.dashboard\data\.env
# Browser development (npm run dev):
#   data\.env inside this project
# The project-root .env.example is a template, not the active credentials file.
